{
  "name": "tano",
  "private": true,
  "version": "0.6.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @tano/client",
    "cache:clean": "pwsh -NoProfile -File scripts/clean-build-cache.ps1",
    "build": "npm run build -w @tano/client",
    "desktop": "node scripts/dev-desktop.mjs",
    "desktop:build": "npm run tauri -w @tano/client -- build",
    "desktop:release": "node scripts/release-desktop.mjs",
    "version:set": "node scripts/version.mjs set",
    "version:check": "node scripts/version.mjs check",
    "updater:manifest": "node scripts/updater-manifest.mjs",
    "android:init": "npm run tauri -w @tano/client -- android init",
    "android:build": "npm run tauri -w @tano/client -- android build",
    "android:dev": "npm run tauri -w @tano/client -- android dev",
    "test:android": "node scripts/android-native-tests.mjs",
    "test:android:lifecycle": "powershell -NoProfile -File scripts/android-lifecycle-smoke.ps1",
    "bench:native": "node scripts/benchmark-native.mjs",
    "test:cross-volume": "node scripts/cross-volume-native.mjs",
    "ios:init": "npm run tauri -w @tano/client -- ios init --ci",
    "ios:dev": "npm run tauri -w @tano/client -- ios dev",
    "ios:build": "npm run tauri -w @tano/client -- ios build --ci",
    "typecheck": "npm run typecheck -w @tano/client && npm run typecheck -w @tano/mcp && npm run typecheck:plugins",
    "typecheck:plugins": "tsc --project examples/plugins/task-insights/tsconfig.json && node scripts/bundle-plugins.mjs --check",
    "test": "vitest run --maxWorkers=2",
    "test:plugins:browser": "playwright test",
    "test:mobile:browser": "playwright test mobile-browser.spec.mjs",
    "test:plugins:native": "node scripts/plugin-native-smoke.mjs",
    "plugin": "node scripts/plugin.mjs",
    "plugin:bundle": "node scripts/bundle-plugins.mjs",
    "test:native": "node scripts/test-native.mjs",
    "check": "npm run version:check && npm run demo:check && npm run emoji:check && npm run typecheck && npm test && npm run build && npm run mcp:build && npm run docs:check && npm run boundary:check",
    "mcp:build": "npm run build -w @tano/mcp",
    "mcp:start": "npm run start -w @tano/mcp",
    "mcp:smoke": "node scripts/mcp-smoke.mjs",
    "docs:check": "node scripts/check-doc-links.mjs",
    "demo:generate": "node scripts/markdown-demo.mjs",
    "demo:check": "node scripts/markdown-demo.mjs --check",
    "emoji:generate": "node scripts/build-workspace-emoji-catalog.mjs && node scripts/build-workspace-emoji-sprite.mjs",
    "emoji:check": "node scripts/build-workspace-emoji-catalog.mjs --check && node scripts/build-workspace-emoji-sprite.mjs --check",
    "core:export": "npm run demo:generate && npm run mcp:build && node scripts/export-core.mjs",
    "boundary:check": "node scripts/check-boundaries.mjs",
    "notices:generate": "node scripts/generate-notices.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "chart.js": "4.5.1",
    "emojibase-data": "17.0.0",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.5",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24.12"
  },
  "license": "MIT",
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
