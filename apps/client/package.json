{
  "name": "@tano/client",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node ../../scripts/markdown-demo.mjs",
    "dev": "vite",
    "prebuild": "node ../../scripts/markdown-demo.mjs",
    "build": "vue-tsc --noEmit && vite build",
